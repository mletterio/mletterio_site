---
const realPhotos = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/trail/*.{jpg,jpeg,png,webp,avif}',
	{ eager: true }
);

const LOW_RES_THRESHOLD = 1200;

const trail = Object.values(realPhotos).map((mod) => ({
	src: mod.default.src,
	lowRes: mod.default.width < LOW_RES_THRESHOLD,
}));
---

<div class="trail" aria-hidden="true">
	{trail.map((item) => (
		<img
			src={item.src}
			alt=""
			class="trail__item"
			data-low-res={item.lowRes ? 'true' : 'false'}
			loading="eager"
			decoding="async"
		/>
	))}
</div>

<style>
	.trail {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 1;
		overflow: hidden;
	}

	.trail__item {
		position: absolute;
		top: 0;
		left: 0;
		width: clamp(140px, 16vw, 240px);
		height: auto;
		max-height: 40vh;
		object-fit: cover;
		border-radius: 2px;
		opacity: 0;
		will-change: transform, opacity;
		filter: saturate(0.95);
	}

	.trail__item[data-low-res='true'] {
		width: clamp(90px, 9vw, 140px);
		filter: saturate(0.75) brightness(1.02);
	}

	@media (max-width: 1200px) {
		.trail__item {
			width: clamp(100px, 22vw, 160px);
		}
		.trail__item[data-low-res='true'] {
			width: clamp(70px, 14vw, 110px);
		}
	}
</style>
