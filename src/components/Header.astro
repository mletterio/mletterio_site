---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<span class="ledge-top" aria-hidden="true"></span>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-links">
			<HeaderLink href="https://www.linkedin.com/in/michael-letterio" target="_blank" rel="noopener noreferrer">LinkedIn&nbsp;→</HeaderLink>
			<HeaderLink href="https://github.com/mletterio" target="_blank" rel="noopener noreferrer">GitHub&nbsp;→</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		background: transparent;
	}
	h2 {
		font-size: clamp(2.25rem, 3.2vw, 3rem);
		font-weight: var(--font-weight-semibold);
		letter-spacing: -0.02em;
		word-spacing: 0.2em;
		margin: 0;
		line-height: 1;
	}

	h2 a {
		text-decoration: none;
		display: block;
	}

	/* Layout for SplitText word boxes. The line-level overflow:hidden
	   added by SplitText's mask:'lines' handles intro clipping; the
	   collapse exit is a single block translate on the parent <a>, so
	   no per-word clip-path is needed. */
	:global(.logo-word) {
		display: inline-block;
		padding-bottom: 0.12em;
		line-height: 1;
		vertical-align: top;
		white-space: nowrap;
	}

	nav {
		display: flex;
		flex-direction: row;
		/* Baseline so the wordmark and link text share a typographic
		   baseline — the look the user is asking for. The ledge sits at
		   the wordmark's top via padding-top math on .nav-links below. */
		align-items: baseline;
		justify-content: left;
		line-height: 1.25em;
		gap: 1.5em;
		padding: 0.25em var(--layout-px);
		max-width: var(--layout-max);
		margin: 0 auto;
		box-sizing: border-box;
		/* Hosted on <nav> so both the desktop ledge (.nav-links::before)
		   and the mobile ledge (.ledge-top) inherit it. Start fully
		   wiped (hidden) so a refresh doesn't flash the ledge before
		   the intro JS runs. */
		--ledge-wipe: 100%;
	}

	/* Mobile-only ledge anchored to nav top. Hidden by default — the
	   phone breakpoint promotes it to display:block. It functions as
	   the "scroll-locked cutoff" the desktop ledge plays in row layout. */
	.ledge-top {
		display: none;
	}

	.nav-links {
		display: flex;
		align-items: baseline;
		gap: 0.85em;
		font-size: 1.4em;
		/* padding-top extends the .nav-links box upward so its top edge
		   (where the ::before ledge sits) lands on the wordmark's
		   visible cap-top — top of the "M" stroke. The value is
		   computed at runtime (animations.ts → measureLedgeOffset),
		   which paints "M" in the wordmark's font and scans for the
		   first ink pixel. The 0.4em fallback applies before JS runs
		   or when JS is disabled — close enough that there's no flash. */
		padding-top: var(--ledge-offset, 0.4em);
		flex-grow: 1;
		justify-content: flex-end;
		box-sizing: border-box;
		overflow: hidden;
		position: relative;
	}

	.nav-links::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--gray-dark);
		clip-path: inset(0 0 0 var(--ledge-wipe));
	}

	nav a {
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
	}

	/* Tablet portrait, foldable inner, narrow desktop window.
	   Threshold picked so title + all 4 nav links fit on one row above it. */
	@media (max-width: 1200px) {
		h2 {
			font-size: 2.2em;
		}

		nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25em;
		}

		.nav-links {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.75em;
			width: 100%;
		}

		nav a {
			font-size: 1.0em;
		}
	}

	/* Phone: 2×2 grid for symmetric tap targets + tighter vertical rhythm */
	@media (max-width: 640px) {
		h2 {
			font-size: 1.75em;
			line-height: 1;
			/* Visual breathing room from the ledge lives INSIDE h2 (as
			   padding) rather than as a nav gap, so h2's overflow clip
			   boundary sits at the ledge line itself. With nav gap > 0
			   the clip would land below the ledge and the wordmark would
			   appear to vanish into a gap instead of into the ledge. */
			padding-top: 0.5em;
			/* Clip the wordmark at h2's top edge (= just under the ledge)
			   so the collapse translate appears to disappear INTO the
			   ledge instead of past the viewport top. */
			overflow: hidden;
		}

		/* Stack the logo words vertically so "MICHAEL" and "LETTERIO" each
		   get their own line instead of overflowing the content box. */
		:global(.logo-word) {
			display: block;
		}

		nav {
			gap: 0;
		}

		/* Promote the top ledge: a 2px line at nav top, wipes right→left
		   driven by --ledge-wipe inherited from <nav>. */
		.ledge-top {
			display: block;
			width: 100%;
			height: 2px;
			background: var(--gray-dark);
			clip-path: inset(0 var(--ledge-wipe) 0 0);
		}

		/* Mobile uses .ledge-top as the cutoff; demote the .nav-links
		   divider ledge so the wordmark/links don't read as separated. */
		.nav-links::before {
			display: none;
		}

		.nav-links {
			display: grid;
			grid-template-columns: 1fr 1fr;
			column-gap: 0.5em;
			row-gap: 0;
			align-items: stretch;
			width: 100%;
			font-size: 1.15em;
		}

		.nav-links a {
			display: inline-flex;
			align-items: center;
			justify-content: flex-start;
			min-height: 40px;
			padding: 0.15em 0.1em;
			font-size: 0.9em;
		}
	}
</style>
