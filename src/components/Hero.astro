---

<section class="hero" id="top">
	<div class="hero__content">
		<h1 class="hero__intro">
			I'm Michael, a software engineer based in Boston. I spend my time
			thinking about how things are built — in code, and out in the world,
			wherever that takes me.
		</h1>
	</div>
</section>

<style>
	.hero {
		min-height: 100svh;
		/* Top padding falls back to header clearance on short/landscape
		   viewports (where 58svh < header-h + space), preserving the safety
		   from the old safe-center layout. On tall viewports, 58svh pushes
		   the sentence into the lower third — first baseline lands ~62–66svh. */
		padding: max(calc(var(--header-h) + var(--space-md)), 58svh)
			var(--layout-px) var(--space-xl);
		max-width: var(--layout-max);
		margin: 0 auto;
		box-sizing: border-box;
		scroll-margin-top: var(--header-h);
	}

	.hero__content {
		max-width: 100%;
	}

	h1.hero__intro {
		font-size: var(--type-intro);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.005em;
		margin: 0;
		max-width: 38ch;
		/* Avoid widow words (e.g. "camera." alone on the last line). Falls
		   back gracefully on browsers without text-wrap support. */
		text-wrap: pretty;
	}

	/* SplitText injects line wrappers with overflow:hidden when mask:'lines'
	   is set; descenders (g, p, y) need bottom breathing room. */
	:global(.intro-line) {
		padding-bottom: 0.12em;
	}

	:global(.intro-word) {
		display: inline-block;
		vertical-align: top;
		line-height: 1;
		will-change: transform;
	}
</style>
