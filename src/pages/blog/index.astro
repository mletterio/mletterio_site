---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 640px;
			}
			h1 {
				margin-bottom: 2rem;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}
			.post-list li a {
				display: block;
				text-decoration: none;
				color: inherit;
			}
			.post-title {
				font-size: 1.25em;
				font-weight: var(--font-weight-semibold);
				color: rgb(var(--black));
				margin: 0 0 0.25rem;
				transition: color 0.15s ease;
			}
			.post-list li a:hover .post-title {
				color: var(--accent);
			}
			.post-date {
				font-size: 0.85em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.post-description {
				font-size: 0.95em;
				color: rgb(var(--gray));
				margin: 0.35rem 0 0;
			}
			.empty-state {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Writing</h1>
			{posts.length === 0 ? (
				<p class="empty-state">Nothing published yet. Check back soon.</p>
			) : (
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.slug}/`}>
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-description">{post.data.description}</p>
								)}
							</a>
						</li>
					))}
				</ul>
			)}
		</main>
		<Footer />
	</body>
</html>
