---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import TrailLayer from "../components/TrailLayer.astro";
import Section from "../components/Section.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    {/* Header and TrailLayer stay outside #smooth-wrapper because both use
        position: fixed — and CSS transforms on a smoothed wrapper would
        create a new containing block, breaking position: fixed. */}
    <Header />
    <TrailLayer />

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main>
          <Hero />

          <Section
            id="about"
            label="01 / About"
            heading="<em>Paying attention</em> to the world, on purpose."
          >
            <p class="section__body">
              Congue sed mauris auctor commodo cum eros etiam; ante id. Placerat
              blandit rhoncus scelerisque interdum a felis mauris curabitur cursus.
              Vulputate curabitur montes at gravida facilisis dui facilisi sapien.
            </p>
          </Section>

          <Section
            id="professional"
            class="section--professional"
            label="02 / Professional"
            heading="<em>Engineering</em> & craft, in parallel."
          >
            <p class="section__body">
              Sollicitudin tempor nam enim ullamcorper phasellus natoque lacus eget
              sit. Praesent etiam lobortis sagittis fringilla congue duis cras
              platea at ornare? Dictumst sagittis nisl platea suscipit, quis
              ullamcorper.
            </p>
            <div class="section__links">
              <a
                href="https://www.linkedin.com/in/michael-letterio"
                target="_blank"
                rel="noopener noreferrer">LinkedIn&nbsp;→</a
              >
              <a
                href="https://github.com/mletterio"
                target="_blank"
                rel="noopener noreferrer">GitHub&nbsp;→</a
              >
            </div>
          </Section>
        </main>

        <Footer />
      </div>
    </div>

    <script>
      import "../scripts/animations.ts";
    </script>

    <style>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }

      :global(header) {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: transparent;
        padding: 2em 0;
        will-change: transform;
      }

      /* Stacking at root level (top → bottom):
           header (z 100)  →  #smooth-wrapper (z 2)  →  .trail (z 1)
         z-index on `main` / `footer` doesn't help here because
         `#smooth-content`'s `will-change: transform` creates its own
         stacking context, trapping their z-indices inside it. */
      :global(#smooth-wrapper) {
        z-index: 2;
      }
    </style>
  </body>
</html>
