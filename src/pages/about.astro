---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="About Michael Letterio — photographer and writer based in Boston, MA." />
		<style>
			main {
				max-width: 640px;
			}
			h1 {
				margin-bottom: 2rem;
			}
			.section {
				margin-bottom: 2.5rem;
			}
			.section h2 {
				font-size: 1em;
				font-weight: var(--font-weight-semibold);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: rgb(var(--gray));
				margin-bottom: 0.75rem;
			}
			.section p {
				color: rgb(var(--gray-dark));
			}
			.contact-links {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}
			.contact-links a {
				color: rgb(var(--black));
				text-decoration: none;
				border-bottom: 1px solid var(--accent);
				width: fit-content;
			}
			.contact-links a:hover {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>

			<div class="section">
				<h2>Bio</h2>
				<p>
					Michael Letterio is a photographer and writer based in Boston, MA.
				</p>
			</div>

			<div class="section">
				<h2>Photography</h2>
				<p>
					I shoot primarily on film and digital. My work spans street, landscape, and portraiture.
					You can browse my photos in the <a href="/gallery/">gallery</a>.
				</p>
			</div>

			<div class="section">
				<h2>Writing</h2>
				<p>
					I write about photography, technology, and whatever else is on my mind.
					You can read my posts on the <a href="/blog/">blog</a>.
				</p>
			</div>

			<div class="section">
				<h2>Contact</h2>
				<div class="contact-links">
					<a href="https://www.linkedin.com/in/michael-letterio" target="_blank" rel="noopener noreferrer">LinkedIn →</a>
					<a href="https://github.com/mletterio" target="_blank" rel="noopener noreferrer">GitHub →</a>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
